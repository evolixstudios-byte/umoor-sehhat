# Copy to .env for local use. Configure production values on Render.
PORT=3000
# Leave DATABASE_URL empty for local SQLite; set on Render for Neon.
DATABASE_URL=
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=evolixstudio@gmail.com
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-password
STAFF_INITIAL_PIN=5253
# Required on Render and Cloudflare Pages; leave empty for local use.
PROXY_SECRET=
# Cloudflare Pages only:
# API_ORIGIN=https://your-backend.onrender.com
# Optional Sheets backup:
# SHEETS_WEBAPP_URL=https://script.google.com/macros/s/YOUR_ID/exec
# SHEETS_WEBHOOK_SECRET=replace-with-at-least-24-random-characters
